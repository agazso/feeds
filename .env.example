# Copy to .env next to docker-compose.yml and fill in secrets. Do NOT commit .env.
PORT=3000

# Runtime state -> subpaths of the /data volume.
FEEDS_DATA_DIR=/data/feeds
FEEDS_CACHE_DIR=/data/cache
FEEDS_MODELS_DIR=/data/models

# Comma-separated auth keys for cookie login.
FEEDS_AUTH_KEYS=

# Required behind a TLS-terminating proxy, or adapter-node rejects POST/auth.
ORIGIN=https://feeds.example.com
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
